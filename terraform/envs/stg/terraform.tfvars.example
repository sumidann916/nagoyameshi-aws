# 検証。terraform.tfvars にコピーして値を入れる（terraform.tfvars は Git に含めない）
env            = "stg"
tfstate_bucket = "nagoyameshi-tfstate-xxxxxxxx" # bootstrap の出力

vpc_cidr = "10.1.0.0/16" # 本番 10.0.0.0/16・検証 10.1.0.0/16

subdomain     = "stg"                 # stg.example.com
allowed_cidrs = ["203.0.113.10/32"]   # ALB に接続できる社内の IP（未定・確認事項。この値は例）

app_env           = "staging"
mail_from_address = "no-reply@example.com" # 未定（確認事項）

min_count = 1 # 最小構成。Auto Scaling しない
max_count = 1

db_multi_az            = false
db_deletion_protection = false
db_final_snapshot      = false

full_monitoring    = false # ログの ERROR のみ
log_retention_days = 7

github_owner     = "sumidann916"
github_repo      = "nagoyameshi-aws"
github_branch    = "develop"              # 未定（確認事項）
require_approval = false
